# Get a free key at https://console.groq.com/keys ("Create API Key").
# Never commit your real key or prefix it with NEXT_PUBLIC_ -- it must stay
# server-side only.
GROQ_API_KEY=your_groq_api_key_here

# Optional override, tried before the built-in fallback chain (see
# FALLBACK_MODELS in lib/groq-client.ts).
GROQ_MODEL=openai/gpt-oss-120b

# Create a free project at https://supabase.com/dashboard, then copy these
# from Project Settings -> Data API. The anon key is safe to expose to the
# browser (NEXT_PUBLIC_) -- Row Level Security policies (see
# supabase/schema.sql) are what actually restrict access per-user.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional. Set this to your deployed URL once you have one (e.g.
# https://your-app.vercel.app) so absolute URLs -- like the Open Graph image
# used for link previews -- resolve correctly. Defaults to localhost.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
